rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} { 
      allow read, write: if false; 
    }

    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { 
      return true; 
    }

    // Validation for StockTab
    function isValidStockTab(data) {
      return data.keys().hasAll(['userId', 'symbol'])
        && data.userId is string && data.userId.size() > 0
        && data.symbol is string && data.symbol.size() > 0 && data.symbol.size() <= 50
        && ( !('status' in data) || data.status is string )
        && ( !('tradeType' in data) || data.tradeType in ['simulated', 'real'] )
        && ( !('companyName' in data) || data.companyName is string )
        && ( !('finalPnL' in data) || data.finalPnL is number )
        && ( !('currentPrice' in data) || data.currentPrice is number )
        && ( !('tags' in data) || data.tags is list )
        && ( !('isFavoriteHighlight' in data) || data.isFavoriteHighlight is bool )
        && ( !('isHidden' in data) || data.isHidden is bool )
        && ( !('sortOrder' in data) || data.sortOrder is number )
        && ( !('buyRate' in data) || data.buyRate is number || data.buyRate is string )
        && ( !('sellRate' in data) || data.sellRate is number || data.sellRate is string )
        && ( !('rating' in data) || data.rating is number || data.rating is string )
        && ( !('volatility' in data) || data.volatility is string )
        && ( !('qualityScore' in data) || data.qualityScore is number || data.qualityScore is string )
        && ( !('valueScore' in data) || data.valueScore is number || data.valueScore is string )
        && ( !('holdingStatus' in data) || data.holdingStatus is string )
        && ( !('isOperationConfirmed' in data) || data.isOperationConfirmed is bool )
        && ( !('createdAt' in data) || data.createdAt is timestamp || data.createdAt == request.time )
        && ( !('updatedAt' in data) || data.updatedAt is timestamp || data.updatedAt == request.time )
        && ( !('chartAnnotations' in data) || data.chartAnnotations is list );
    }

    // Validation for Trade
    function isValidTrade(data) {
      return data.keys().hasAll(['type', 'price', 'quantity', 'tradeDate', 'createdAt'])
        && data.type in ['BUY', 'SELL']
        && data.price is number && data.price >= 0
        && data.quantity is number && data.quantity > 0
        && data.tradeDate is timestamp
        && (data.createdAt is timestamp || data.createdAt == request.time)
        && ( !('fees' in data) || (data.fees is number && data.fees >= 0) )
        && ( !('tags' in data) || (data.tags is list && data.tags.size() <= 10) )
        && ( !('notes' in data) || (data.notes is string && data.notes.size() <= 2000) );
    }

    // Validation for PlannedOrder
    function isValidPlannedOrder(data) {
      return data.keys().hasAll(['direction', 'price', 'quantity', 'status', 'createdAt'])
        && data.direction in ['BUY', 'SELL']
        && data.price is number && data.price >= 0
        && data.quantity is number && data.quantity >= 0
        && data.status in ['PENDING', 'CANCELLED', 'COMPLETED']
        && (data.createdAt is timestamp || data.createdAt == request.time)
        && ( !('category' in data) || (data.category is string && data.category.size() <= 100) )
        && ( !('purpose' in data) || (data.purpose is string && data.purpose.size() <= 100) )
        && ( !('conditions' in data) || (data.conditions is string && data.conditions.size() <= 2000) )
        && ( !('notes' in data) || (data.notes is string && data.notes.size() <= 2000) )
        && ( !('isManualHighlight' in data) || data.isManualHighlight is bool )
        && ( !('plannedDate' in data) || data.plannedDate is timestamp );
    }

    // Validation for StrategyConfig
    function isValidStrategyConfig(data) {
      return ( !('updatedAt' in data) || data.updatedAt is timestamp || data.updatedAt == request.time )
        && ( !('entries' in data) || data.entries is list )
        && ( !('resistanceZones' in data) || data.resistanceZones is list )
        && ( !('supportZones' in data) || data.supportZones is list )
        && ( !('tp1' in data) || data.tp1 is number || data.tp1 is string )
        && ( !('tp2' in data) || data.tp2 is number || data.tp2 is string )
        && ( !('tp3' in data) || data.tp3 is number || data.tp3 is string )
        && ( !('tpTargets' in data) || data.tpTargets is list )
        && ( !('slTargets' in data) || data.slTargets is list )
        && ( !('sl' in data) || data.sl is number || data.sl is string )
        && ( !('slPercentage' in data) || data.slPercentage is number || data.slPercentage is string )
        && ( !('slConditions' in data) || data.slConditions is string )
        && ( !('strategyNotes' in data) || data.strategyNotes is string )
        && ( !('operationNote' in data) || data.operationNote is string )
        && ( !('operationFocus' in data) || data.operationFocus is string )
        && ( !('tpChecked' in data) || data.tpChecked is bool )
        && ( !('slChecked' in data) || data.slChecked is bool )
        && ( !('addChecked' in data) || data.addChecked is bool )
        && ( !('closeChecked' in data) || data.closeChecked is bool )
        && ( !('observeChecked' in data) || data.observeChecked is bool )
        && ( !('notesHighlighted' in data) || data.notesHighlighted is bool )
        && ( !('buyPercentage' in data) || data.buyPercentage is number || data.buyPercentage is string )
        && ( !('refPnLPoint' in data) || data.refPnLPoint is number || data.refPnLPoint is string )
        && ( !('refPnLPointSys2' in data) || data.refPnLPointSys2 is number || data.refPnLPointSys2 is string )
        && ( !('includeCurrentHolding' in data) || data.includeCurrentHolding is bool )
        && ( !('averagingRows' in data) || data.averagingRows is list )
        && ( !('averagingRowsSys2' in data) || data.averagingRowsSys2 is list )
        && ( !('tags' in data) || data.tags is list )
        && ( !('id' in data) || data.id is string );
    }

    // Validation for DailyReport
    function isValidDailyReport(data) {
      return ( !('updatedAt' in data) || data.updatedAt is timestamp || data.updatedAt == request.time )
        && ( !('pdfUrl1' in data) || (data.pdfUrl1 is string && data.pdfUrl1.size() <= 2000) )
        && ( !('pdfUrl2' in data) || (data.pdfUrl2 is string && data.pdfUrl2.size() <= 2000) );
    }

    // Validation for ChipAnalysis
    function isValidChipAnalysis(data) {
      return data.keys().hasAll(['stage', 'patternExplanation', 'actionSuggestions', 'warnings', 'candlestickSupport', 'signalType', 'signalExplanation'])
        && data.stage is map
        && data.patternExplanation is string
        && data.actionSuggestions is string
        && data.warnings is map
        && data.candlestickSupport is map
        && data.signalType is string
        && data.signalExplanation is string
        && ( !('previewImage' in data) || data.previewImage is string )
        && ( !('scannedAt' in data) || data.scannedAt is string );
    }

    // Validation for SocratesData
    function isValidSocratesData(data) {
      return ( !('strong' in data) || (data.strong is list && data.strong.size() <= 500) )
        && ( !('weak' in data) || (data.weak is list && data.weak.size() <= 500) );
    }

    // Validation for UserSettings
    function isValidUserSettings(data) {
      return ( !('totalCapital' in data) || (data.totalCapital is number && data.totalCapital >= 0) )
        && ( !('virtualCapital' in data) || (data.virtualCapital is number && data.virtualCapital >= 0) )
        && ( !('bankAccountBalance' in data) || (data.bankAccountBalance is number && data.bankAccountBalance >= 0) )
        && ( !('selectedCardIds' in data) || data.selectedCardIds is list )
        && ( !('customPrompts' in data) || data.customPrompts is list )
        && ( !('simulatedPreOrders' in data) || data.simulatedPreOrders is map )
        && ( !('updatedAt' in data) || data.updatedAt is timestamp || data.updatedAt == request.time || data.updatedAt is string );
    }

    // Validation for VisualLinesBoard
    function isValidVisualLinesBoard(data) {
      return ( !('positions' in data) || data.positions is map )
        && ( !('updatedAt' in data) || data.updatedAt is string || data.updatedAt is timestamp || data.updatedAt == request.time );
    }

    match /userSettings/{userId} {
      allow get, list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidUserSettings(incoming());
      allow delete: if isSignedIn();
    }

    match /users/{userId}/socratesData/{dateKey} {
      allow list, get: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(dateKey) && isValidSocratesData(incoming());
      allow delete: if isSignedIn() && isValidId(dateKey);
    }

    match /users/{userId}/visualLinesBoard/{boardId} {
      allow list, get: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(boardId) && isValidVisualLinesBoard(incoming());
      allow delete: if isSignedIn() && isValidId(boardId);
    }

    match /visualLinesBoard/{boardId} {
      allow list, get: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(boardId) && isValidVisualLinesBoard(incoming());
      allow delete: if isSignedIn() && isValidId(boardId);
    }

    match /stockTabs/{tabId} {
      allow get: if isSignedIn() && isValidId(tabId);
      allow list: if isSignedIn();
      
      allow create: if isSignedIn() && isValidId(tabId) && isValidStockTab(incoming())
        && ( !('createdAt' in incoming()) || incoming().createdAt is timestamp || incoming().createdAt == request.time )
        && ( !('updatedAt' in incoming()) || incoming().updatedAt is timestamp || incoming().updatedAt == request.time );
        
      allow update: if isSignedIn() && isValidId(tabId) && isValidStockTab(incoming())
        && (!('createdAt' in resource.data) || incoming().createdAt == resource.data.createdAt)
        && (!('updatedAt' in incoming()) || incoming().updatedAt is timestamp || incoming().updatedAt == request.time );
        
      allow delete: if isSignedIn() && isValidId(tabId);

      match /trades/{tradeId} {
        allow get: if isSignedIn() && isValidId(tabId) && isValidId(tradeId);
        allow list: if isSignedIn();
        
        allow create: if isSignedIn() && isValidId(tabId) && isValidId(tradeId) && isValidTrade(incoming())
          && ( !('createdAt' in incoming()) || incoming().createdAt is timestamp );
          
        allow update: if isSignedIn() && isValidId(tabId) && isValidId(tradeId) && isValidTrade(incoming())
          && (!('createdAt' in resource.data) || incoming().createdAt == resource.data.createdAt);
          
        allow delete: if isSignedIn() && isValidId(tabId) && isValidId(tradeId);
      }

      match /plannedOrders/{orderId} {
        allow get: if isSignedIn() && isValidId(tabId) && isValidId(orderId);
        allow list: if isSignedIn();
        
        allow create: if isSignedIn() && isValidId(tabId) && isValidId(orderId) && isValidPlannedOrder(incoming())
          && ( !('createdAt' in incoming()) || incoming().createdAt is timestamp );
          
        allow update: if isSignedIn() && isValidId(tabId) && isValidId(orderId) && isValidPlannedOrder(incoming())
          && (!('createdAt' in resource.data) || incoming().createdAt == resource.data.createdAt);
          
        allow delete: if isSignedIn() && isValidId(tabId) && isValidId(orderId);
      }

      match /strategy/{strategyId} {
        allow get: if isSignedIn() && isValidId(tabId) && isValidId(strategyId);
        allow list: if isSignedIn();
        
        allow create: if isSignedIn() && isValidId(tabId) && isValidId(strategyId) && isValidStrategyConfig(incoming())
          && ( !('updatedAt' in incoming()) || incoming().updatedAt is timestamp || incoming().updatedAt == request.time );
          
        allow update: if isSignedIn() && isValidId(tabId) && isValidId(strategyId) && isValidStrategyConfig(incoming())
          && (!('updatedAt' in incoming()) || incoming().updatedAt is timestamp || incoming().updatedAt == request.time);
          
        allow delete: if isSignedIn() && isValidId(tabId) && isValidId(strategyId);
      }

      match /dailyReports/{reportId} {
        allow get: if isSignedIn() && isValidId(tabId) && isValidId(reportId);
        allow list: if isSignedIn();
        
        allow create, update: if isSignedIn() && isValidId(tabId) && isValidId(reportId) && isValidDailyReport(incoming())
          && ( !('updatedAt' in incoming()) || incoming().updatedAt is timestamp || incoming().updatedAt == request.time );
          
        allow delete: if isSignedIn() && isValidId(tabId) && isValidId(reportId);
      }

      match /chipAnalysis/{analysisId} {
        allow get: if isSignedIn() && isValidId(tabId) && isValidId(analysisId);
        allow list: if isSignedIn();
        
        allow create, update: if isSignedIn() && isValidId(tabId) && isValidId(analysisId) && isValidChipAnalysis(incoming());
          
        allow delete: if isSignedIn() && isValidId(tabId) && isValidId(analysisId);
      }
    }
  }
}
