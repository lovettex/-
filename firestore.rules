rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} { 
      allow read, write: if false; 
    }

    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { 
      return request.auth != null && request.auth.token.email_verified == true; 
    }

    // Validation for StockTab
    function isValidStockTab(data) {
      return data.keys().hasAll(['userId', 'symbol'])
        && data.userId == request.auth.uid
        && data.symbol is string && data.symbol.size() > 0 && data.symbol.size() <= 20
        && ( !('status' in data) || data.status in ['ACTIVE', 'COMPLETED'] )
        && ( !('tradeType' in data) || data.tradeType in ['simulated', 'real'] )
        && ( !('companyName' in data) || (data.companyName is string && data.companyName.size() <= 100) )
        && ( !('finalPnL' in data) || data.finalPnL is number )
        && ( !('currentPrice' in data) || data.currentPrice is number )
        && ( !('tags' in data) || (data.tags is list && data.tags.size() <= 20) )
        && ( !('isFavoriteHighlight' in data) || data.isFavoriteHighlight is bool )
        && ( !('isHidden' in data) || data.isHidden is bool )
        && ( !('sortOrder' in data) || data.sortOrder is number )
        && ( !('recommendation' in data) || (data.recommendation is string && data.recommendation.size() <= 100) )
        && ( !('rating' in data) || data.rating is number )
        && ( !('sentiment' in data) || data.sentiment is number )
        && ( !('volatility' in data) || (data.volatility is string && data.volatility.size() <= 100) )
        && ( !('shortTermImpact' in data) || (data.shortTermImpact is string && data.shortTermImpact.size() <= 100) )
        && ( !('longTermOutlook' in data) || (data.longTermOutlook is string && data.longTermOutlook.size() <= 100) )
        && ( !('createdAt' in data) || data.createdAt is timestamp )
        && ( !('updatedAt' in data) || data.updatedAt is timestamp );
    }

    // Validation for Trade
    function isValidTrade(data) {
      return data.keys().hasAll(['type', 'price', 'quantity', 'tradeDate', 'createdAt'])
        && data.type in ['BUY', 'SELL']
        && data.price is number && data.price >= 0
        && data.quantity is number && data.quantity > 0
        && data.tradeDate is timestamp
        && data.createdAt is timestamp
        && ( !('fees' in data) || (data.fees is number && data.fees >= 0) )
        && ( !('tags' in data) || (data.tags is list && data.tags.size() <= 10) )
        && ( !('notes' in data) || (data.notes is string && data.notes.size() <= 2000) );
    }

    // Validation for PlannedOrder
    function isValidPlannedOrder(data) {
      return data.keys().hasAll(['direction', 'price', 'quantity', 'status', 'createdAt'])
        && data.direction in ['BUY', 'SELL']
        && data.price is number && data.price >= 0
        && data.quantity is number && data.quantity >= 0
        && data.status in ['PENDING', 'CANCELLED', 'COMPLETED']
        && data.createdAt is timestamp
        && ( !('category' in data) || (data.category is string && data.category.size() <= 100) )
        && ( !('purpose' in data) || (data.purpose is string && data.purpose.size() <= 100) )
        && ( !('conditions' in data) || (data.conditions is string && data.conditions.size() <= 2000) )
        && ( !('notes' in data) || (data.notes is string && data.notes.size() <= 2000) )
        && ( !('isManualHighlight' in data) || data.isManualHighlight is bool )
        && ( !('plannedDate' in data) || data.plannedDate is timestamp );
    }

    // Validation for StrategyConfig
    function isValidStrategyConfig(data) {
      return data.keys().hasAll(['updatedAt'])
        && data.updatedAt is timestamp
        && ( !('entries' in data) || (data.entries is list && data.entries.size() <= 20) )
        && ( !('resistanceZones' in data) || (data.resistanceZones is list && data.resistanceZones.size() <= 10) )
        && ( !('supportZones' in data) || (data.supportZones is list && data.supportZones.size() <= 10) )
        && ( !('tp1' in data) || data.tp1 is number )
        && ( !('tp2' in data) || data.tp2 is number )
        && ( !('tp3' in data) || data.tp3 is number )
        && ( !('tpTargets' in data) || (data.tpTargets is list && data.tpTargets.size() <= 10) )
        && ( !('slTargets' in data) || (data.slTargets is list && data.slTargets.size() <= 10) )
        && ( !('sl' in data) || data.sl is number )
        && ( !('slConditions' in data) || (data.slConditions is string && data.slConditions.size() <= 2000) )
        && ( !('strategyNotes' in data) || (data.strategyNotes is string && data.strategyNotes.size() <= 5000) )
        && ( !('tags' in data) || (data.tags is list && data.tags.size() <= 20) );
    }

    // Validation for DailyReport
    function isValidDailyReport(data) {
      return data.keys().hasAll(['updatedAt'])
        && data.updatedAt is timestamp
        && ( !('pdfUrl1' in data) || (data.pdfUrl1 is string && data.pdfUrl1.size() <= 2000) )
        && ( !('pdfUrl2' in data) || (data.pdfUrl2 is string && data.pdfUrl2.size() <= 2000) );
    }

    // Validation for SocratesData
    function isValidSocratesData(data) {
      return ( !('strong' in data) || (data.strong is list && data.strong.size() <= 500) )
        && ( !('weak' in data) || (data.weak is list && data.weak.size() <= 500) );
    }

    match /users/{userId}/socratesData/{dateKey} {
      allow list: if isSignedIn() && userId == request.auth.uid;
      allow get: if isSignedIn() && userId == request.auth.uid;
      allow write: if isSignedIn() && userId == request.auth.uid && isValidId(dateKey) && isValidSocratesData(incoming());
    }

    match /stockTabs/{tabId} {
      allow get: if isSignedIn() && isValidId(tabId) && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      
      allow create: if isSignedIn() && isValidId(tabId) && isValidStockTab(incoming())
        && ( !('createdAt' in incoming()) || incoming().createdAt is timestamp )
        && ( !('updatedAt' in incoming()) || incoming().updatedAt is timestamp );
        
      allow update: if isSignedIn() && isValidId(tabId) && isValidStockTab(incoming())
        && resource.data.userId == request.auth.uid
        && incoming().userId == resource.data.userId
        && (!('createdAt' in resource.data) || incoming().createdAt == resource.data.createdAt)
        && (!('updatedAt' in incoming()) || incoming().updatedAt is timestamp);
        
      allow delete: if isSignedIn() && isValidId(tabId) && resource.data.userId == request.auth.uid;

      match /trades/{tradeId} {
        allow get: if isSignedIn() && isValidId(tabId) && isValidId(tradeId) && get(/databases/$(database)/documents/stockTabs/$(tabId)).data.userId == request.auth.uid;
        allow list: if isSignedIn() && get(/databases/$(database)/documents/stockTabs/$(tabId)).data.userId == request.auth.uid;
        
        allow create: if isSignedIn() && isValidId(tabId) && isValidId(tradeId) && isValidTrade(incoming())
          && get(/databases/$(database)/documents/stockTabs/$(tabId)).data.userId == request.auth.uid
          && ( !('createdAt' in incoming()) || incoming().createdAt is timestamp );
          
        allow update: if isSignedIn() && isValidId(tabId) && isValidId(tradeId) && isValidTrade(incoming())
          && get(/databases/$(database)/documents/stockTabs/$(tabId)).data.userId == request.auth.uid
          && (!('createdAt' in resource.data) || incoming().createdAt == resource.data.createdAt);
          
        allow delete: if isSignedIn() && isValidId(tabId) && isValidId(tradeId) 
          && get(/databases/$(database)/documents/stockTabs/$(tabId)).data.userId == request.auth.uid;
      }

      match /plannedOrders/{orderId} {
        allow get: if isSignedIn() && isValidId(tabId) && isValidId(orderId) && get(/databases/$(database)/documents/stockTabs/$(tabId)).data.userId == request.auth.uid;
        allow list: if isSignedIn() && get(/databases/$(database)/documents/stockTabs/$(tabId)).data.userId == request.auth.uid;
        
        allow create: if isSignedIn() && isValidId(tabId) && isValidId(orderId) && isValidPlannedOrder(incoming())
          && get(/databases/$(database)/documents/stockTabs/$(tabId)).data.userId == request.auth.uid
          && ( !('createdAt' in incoming()) || incoming().createdAt is timestamp );
          
        allow update: if isSignedIn() && isValidId(tabId) && isValidId(orderId) && isValidPlannedOrder(incoming())
          && get(/databases/$(database)/documents/stockTabs/$(tabId)).data.userId == request.auth.uid
          && (!('createdAt' in resource.data) || incoming().createdAt == resource.data.createdAt);
          
        allow delete: if isSignedIn() && isValidId(tabId) && isValidId(orderId) 
          && get(/databases/$(database)/documents/stockTabs/$(tabId)).data.userId == request.auth.uid;
      }

      match /strategy/{strategyId} {
        allow get: if isSignedIn() && isValidId(tabId) && isValidId(strategyId) && get(/databases/$(database)/documents/stockTabs/$(tabId)).data.userId == request.auth.uid;
        allow list: if isSignedIn() && get(/databases/$(database)/documents/stockTabs/$(tabId)).data.userId == request.auth.uid;
        
        allow create: if isSignedIn() && isValidId(tabId) && isValidId(strategyId) && isValidStrategyConfig(incoming())
          && get(/databases/$(database)/documents/stockTabs/$(tabId)).data.userId == request.auth.uid
          && ( !('updatedAt' in incoming()) || incoming().updatedAt is timestamp );
          
        allow update: if isSignedIn() && isValidId(tabId) && isValidId(strategyId) && isValidStrategyConfig(incoming())
          && get(/databases/$(database)/documents/stockTabs/$(tabId)).data.userId == request.auth.uid
          && (!('updatedAt' in incoming()) || incoming().updatedAt is timestamp);
          
        allow delete: if isSignedIn() && isValidId(tabId) && isValidId(strategyId) 
          && get(/databases/$(database)/documents/stockTabs/$(tabId)).data.userId == request.auth.uid;
      }

      match /dailyReports/{reportId} {
        allow get: if isSignedIn() && isValidId(tabId) && isValidId(reportId) && get(/databases/$(database)/documents/stockTabs/$(tabId)).data.userId == request.auth.uid;
        allow list: if isSignedIn() && get(/databases/$(database)/documents/stockTabs/$(tabId)).data.userId == request.auth.uid;
        
        allow create, update: if isSignedIn() && isValidId(tabId) && isValidId(reportId) && isValidDailyReport(incoming())
          && get(/databases/$(database)/documents/stockTabs/$(tabId)).data.userId == request.auth.uid
          && ( !('updatedAt' in incoming()) || incoming().updatedAt is timestamp );
          
        allow delete: if isSignedIn() && isValidId(tabId) && isValidId(reportId) 
          && get(/databases/$(database)/documents/stockTabs/$(tabId)).data.userId == request.auth.uid;
      }
    }
  }
}
